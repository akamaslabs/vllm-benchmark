# Secrets — never commit these (see ROADMAP.md security debt: _old/akamas/workflows/id_rsa
# was a real committed private key).
id_dsa
id_dsa.*
*.pem
*.key
!k8s/**/*.key.yaml
.env
.env.*
**/hf-token*
!**/hf-token*.yaml

# Local Claude Code settings
.claude/settings.local.json

# Private original knowledge sources 
knowledge/sources

# Toolbox SSH keys referenced by the studies' Akamas workflows — live only on the toolbox
# host, never in git (2026-09-14: five studies had committed theirs, see ROADMAP.md
# section E security debt; this rule prevents new ones, it does not untrack the old files).
studies/*/id_rsa
studies/*/akamas/id_rsa
id_rsa
id_rsa.pub

# Rendered per trial on the toolbox by the Akamas FileConfigurator (study 18 onwards)
studies/18-l4-pd-disaggregation-tps-per-gpu/k8s/01-deployment.yaml
studies/19-l4-pd-disaggregation-tps-per-gpu-rerun/k8s/01-deployment.yaml
