# Rendered by the Akamas FileConfigurator task into params.env, then sourced by
# apply_config.sh. The parameters are NOT rendered straight into the StatefulSet because
# the script acts on them first: MIG_PROFILE decides the MIG layout, the device-plugin
# config and the replica count (one replica per MIG instance, the GPU always fully
# partitioned). Every token below must be in the study's parametersSelection:
# apply_config.sh refuses to run if one is left unsubstituted.
MIG_PROFILE=${gpu0.mig_profile}
GPU_MEMORY_UTILIZATION=${vllm.gpu_memory_utilization}
MAX_NUM_SEQS=${vllm.max_num_seqs}
MAX_NUM_BATCHED_TOKENS=${vllm.max_num_batched_tokens}
STREAM_INTERVAL=${vllm.stream_interval}
