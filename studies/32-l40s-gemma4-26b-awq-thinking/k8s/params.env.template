# Rendered by the Akamas FileConfigurator task into params.env, then sourced by
# apply_config.sh -> render_statefulset.sh, which validates every value and writes the vLLM
# flags (booleans become --x / --no-x: vLLM 0.29.0 parses them with BooleanOptionalAction
# and rejects --x=true). Every token must be in the study's parametersSelection
# (ignoreUnsubstitutedTokens false), and render_statefulset.sh refuses a leftover token or
# an empty value.
#
# Domains:
#   - LINEAR_BACKEND: the int4 (W4A16) checkpoint runs on vLLM's mixed-precision kernels. On
#     SM 8.9 auto takes Marlin (CutlassW4A8 and Machete need SM 9.0); torch has no
#     mixed-precision kernel and falls back to auto, marlin is auto's own pick, so neither is
#     tuned. Domain auto, triton (TritonW4A16), humming, from vLLM 0.29.0's source: exllama
#     needs float16 activations (Gemma 4 runs bf16), conch a package the image lacks.
#   - ATTENTION_BACKEND: not tuned (no line), as studies 30/31: vLLM's choice for Gemma 4 on
#     SM 8.9 is TRITON_ATTN (FLASH_ATTN does not start, head_size 512).
#   - SPEC_METHOD / SPEC_TOKENS: Gemma 4's MTP drafter (+50 % at 64 requests with K=2 on the
#     FP8 checkpoint, study 30's probe); none <-> 0 by parameterConstraints.
#   - ENFORCE_EAGER: fixed false (decided with the user): eager / O0 ran ~7x slower at batch 1.
GPU_MEMORY_UTILIZATION=${vllm.gpu_memory_utilization}
MAX_NUM_SEQS=${vllm.max_num_seqs}
MAX_NUM_BATCHED_TOKENS=${vllm.max_num_batched_tokens}
KV_CACHE_DTYPE=${vllm.kv_cache_dtype}
PERFORMANCE_MODE=${vllm.performance_mode}
OPTIMIZATION_LEVEL=${vllm.optimization_level}
ENFORCE_EAGER=false
SCHEDULING_POLICY=${vllm.scheduling_policy}
ASYNC_SCHEDULING=${vllm.async_scheduling}
MAX_CUDAGRAPH_CAPTURE_SIZE=${vllm.max_cudagraph_capture_size}
BLOCK_SIZE=${vllm.block_size}
LINEAR_BACKEND=${vllm.linear_backend}
SPEC_METHOD=${vllm.spec_method}
SPEC_TOKENS=${vllm.spec_tokens}
