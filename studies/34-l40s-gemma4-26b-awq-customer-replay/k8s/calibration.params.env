# vLLM for calibrate_caps.sh (study 34): the customer's compose numerics (bf16 KV cache, no MTP,
# vLLM's own kernels and every other default), so the measured output lengths are the baseline's,
# with two throughput settings raised to shorten the run (~48k requests): MAX_NUM_SEQS 128 (the
# compose's 64) and MAX_NUM_BATCHED_TOKENS 8192 (vLLM's 2496 with the vision tower). They change
# the batch shapes, not the model's numerics: their effect on the generated text is the batch
# noise any run has. Empty = no flag (render_statefulset.sh), as the baseline step renders it.
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=128
MAX_NUM_BATCHED_TOKENS=8192
KV_CACHE_DTYPE=
PERFORMANCE_MODE=
OPTIMIZATION_LEVEL=
ENFORCE_EAGER=false
SCHEDULING_POLICY=
ASYNC_SCHEDULING=
MAX_CUDAGRAPH_CAPTURE_SIZE=
BLOCK_SIZE=
LINEAR_BACKEND=
MOE_BACKEND=
SPEC_METHOD=
SPEC_TOKENS=
LONG_PREFILL_TOKEN_THRESHOLD=
WATERMARK=
SCHEDULER_RESERVE_FULL_ISL=
STREAM_INTERVAL=
