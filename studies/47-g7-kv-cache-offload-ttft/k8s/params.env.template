# Rendered by the Akamas FileConfigurator task into params.env, then sourced by apply_config.sh,
# which turns each value into a vLLM flag. Any value may be EMPTY (a parameter the step lists in
# doNotRenderParameters): no flag, vLLM's own default. KV_OFFLOADING_SIZE 0 also means no flag.
KV_OFFLOADING_SIZE=${vllm.kv_offloading_size}
KV_CACHE_DTYPE=${vllm.kv_cache_dtype}
GPU_MEMORY_UTILIZATION=${vllm.gpu_memory_utilization}
MAX_NUM_SEQS=${vllm.max_num_seqs}
MAX_NUM_BATCHED_TOKENS=${vllm.max_num_batched_tokens}
BLOCK_SIZE=${vllm.block_size}
