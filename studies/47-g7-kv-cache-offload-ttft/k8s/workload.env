# Study 47 workload, sourced by run_load.sh. PROVISIONAL until the calibration run (plan Task 4)
# freezes it: rule fixed in the design before any data (baseline keeps up if completed >= 95 %
# of sent and client TTFT p95 over minutes 6-20 < 10 s; else USERS 64 -> 56 -> 48, RATE =
# USERS / 64 so every user sends one turn every 64 s). Never changed once the study starts.
USERS=64
RATE=1
DURATION=1200        # seconds of load; + 60 s grace
TURNS=10             # turns per conversation (history re-sent every turn)
ISL=600              # tokens per user turn
OSL=200              # tokens per answer (ignore_eos)
STEADY_FROM=360      # client-side RESULT uses requests started >= this many s after the first
