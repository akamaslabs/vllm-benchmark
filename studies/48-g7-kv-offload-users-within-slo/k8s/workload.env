# Study 48 workload, sourced by run_ramp.sh and run_hold.sh. Fixed in the design
# (docs/superpowers/specs/2026-11-06-study-48-kv-offload-users-within-slo-design.md) before any
# data; never changed once the study starts.
# Per user: identical to study 47 (one turn every SECONDS_PER_TURN s, TURNS turns per
# conversation, history re-sent): the request rate of a level is USERS / SECONDS_PER_TURN.
TURNS=10              # turns per conversation (history re-sent every turn)
ISL=600               # tokens per user turn
OSL=200               # tokens per answer (ignore_eos)
SECONDS_PER_TURN=64   # each user sends one turn every 64 s
# Ramp: every level is a fresh AIPerf run of LEVEL_SECONDS (+ 60 s grace), judged on requests
# started >= STEADY_FROM s after its first request (study 47: TTFT p95 rises until minute ~11,
# because a conversation lives 10 turns x 64 s), against client TTFT p95 <= SLO_TTFT_MS.
LEVELS="16 24 32 48 64 80 96 112 128"
LEVEL_SECONDS=960
STEADY_FROM=600
SLO_TTFT_MS=500
