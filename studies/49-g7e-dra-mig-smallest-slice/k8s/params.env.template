# Study 49 (copied from study 46). Rendered by the Akamas FileConfigurator task into params.env, then sourced by
# apply_config.sh. Not rendered straight into the StatefulSet because the
# script acts on MIG_PROFILE first (ResourceClaimTemplate + neighbours) and turns the vLLM
# values into flags (booleans become --x / --no-x: vLLM 0.29.0 rejects --x=true).
# MIG_PROFILE, GPU_MEMORY_UTILIZATION and MAX_NUM_SEQS are always rendered. Any other value may
# be EMPTY (a parameter the step lists in doNotRenderParameters): no flag, vLLM's own default.
#
# Not tuned here although studies 36/38 tuned them (they do not apply to this model):
#   - linear_backend / wna16_activation_dtype: W4A16 (AWQ) kernels; Qwen3-8B-FP8 is FP8.
#   - moe_backend: Qwen3-8B is dense.
#   - spec_method / spec_tokens: mtp needs MTP heads, Qwen3-8B has none.
#   - scheduling_policy: fixed fcfs, AIPerf sends no priorities.
MIG_PROFILE=${gpu0.mig_profile}
GPU_MEMORY_UTILIZATION=${vllm.gpu_memory_utilization}
MAX_NUM_SEQS=${vllm.max_num_seqs}
MAX_NUM_BATCHED_TOKENS=${vllm.max_num_batched_tokens}
KV_CACHE_DTYPE=${vllm.kv_cache_dtype}
PERFORMANCE_MODE=${vllm.performance_mode}
OPTIMIZATION_LEVEL=${vllm.optimization_level}
ASYNC_SCHEDULING=${vllm.async_scheduling}
MAX_CUDAGRAPH_CAPTURE_SIZE=${vllm.max_cudagraph_capture_size}
BLOCK_SIZE=${vllm.block_size}
WATERMARK=${vllm.watermark}
SCHEDULER_RESERVE_FULL_ISL=${vllm.scheduler_reserve_full_isl}
STREAM_INTERVAL=${vllm.stream_interval}
