# Rendered by the Akamas FileConfigurator task into params.env, then sourced by apply_config.sh.
# The first five lines pick the layout (lib_layout.sh); the others become vLLM flags on both pods.
# Any value may be EMPTY (a parameter the step lists in doNotRenderParameters): layout values
# then default to 1 / false, the others to no flag (vLLM's own default).
REPLICAS=${vllm_workload.replicas}
TENSOR_PARALLEL_SIZE=${vllm.tensor_parallel_size}
DATA_PARALLEL_SIZE=${vllm.data_parallel_size}
PIPELINE_PARALLEL_SIZE=${vllm.pipeline_parallel_size}
ENABLE_EXPERT_PARALLEL=${vllm.enable_expert_parallel}
GPU_MEMORY_UTILIZATION=${vllm.gpu_memory_utilization}
MAX_NUM_SEQS=${vllm.max_num_seqs}
MAX_NUM_BATCHED_TOKENS=${vllm.max_num_batched_tokens}
KV_CACHE_DTYPE=${vllm.kv_cache_dtype}
MOE_BACKEND=${vllm.moe_backend}
