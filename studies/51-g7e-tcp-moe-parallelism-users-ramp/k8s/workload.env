# Study 51 workload, sourced by run_ramp.sh and run_hold.sh (and read by lib_load.sh). Fixed in the
# design (docs/superpowers/specs/2026-11-09-study-50-g7e-efa-moe-parallelism-design.md) before any
# data; never changed once the study starts.
# Per user: one turn every SECONDS_PER_TURN s, TURNS turns per conversation, history re-sent (as in
# studies 47 and 48): the request rate of a level is USERS / SECONDS_PER_TURN.
TURNS=10              # turns per conversation (history re-sent every turn)
ISL=600               # tokens per user turn
OSL=200               # tokens per answer (ignore_eos)
SECONDS_PER_TURN=64   # each user sends one turn every 64 s
# Ramp: every level is a fresh AIPerf run of LEVEL_SECONDS (+ 60 s grace), judged on requests
# started >= STEADY_FROM s after its first request (a conversation lives 10 turns x 64 s, so the
# context only stops growing after minute ~11), against client TTFT p95 <= SLO_TTFT_MS.
# Every level is even: the two AIPerf clients take half the users each.
LEVELS="32 64 128 192 256 384 512 768"
LEVEL_SECONDS=960
STEADY_FROM=600
SLO_TTFT_MS=500
# Request fields added to every chat completion (AIPerf --extra-inputs, key:value pairs).
# reasoning_effort low: gpt-oss spends few of the 200 output tokens on its reasoning channel.
EXTRA_INPUTS="ignore_eos:true reasoning_effort:low"
