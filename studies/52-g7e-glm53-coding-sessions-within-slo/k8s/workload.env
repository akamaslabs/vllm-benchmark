# Study 52 workload, sourced by run_ramp.sh and run_hold.sh (and read by lib_load.sh). Fixed in the
# design (docs/superpowers/specs/2026-11-17-study-52-glm53-coding-sessions-design.md) before any
# data; never changed once the study starts.
# A coding-agent session: SHARED_PROMPT tokens of system prompt identical in every session (the
# agent's instructions and tool schemas), USER_CONTEXT tokens of per-session context (files read
# at start), then TURNS turns of ISL input tokens (tool output, user message) and OSL output
# tokens, history re-sent every turn: ~34k tokens at turn 1, ~100k at turn 16.
# One turn per session every SECONDS_PER_TURN s (AIPerf user-centric rate SESSIONS / 30): the
# request rate of a level is SESSIONS / SECONDS_PER_TURN. The period exceeds the slowest answer
# the SLO allows (400 x 50 ms + 5 s = 25 s), so sessions do not slip (builder check 2026-11-17).
SHARED_PROMPT=20000   # tokens, shared by every session
USER_CONTEXT=10000    # tokens, per session
TURNS=16              # turns per session (history re-sent every turn)
ISL=4000              # input tokens added per turn
OSL=400               # output tokens per answer (ignore_eos; reasoning included)
SECONDS_PER_TURN=30   # each session sends one turn every 30 s
# Ramp: every level is a fresh AIPerf run of LEVEL_SECONDS (+ 60 s grace), judged on requests
# started >= STEADY_FROM s after its first request (a session lives 16 x 30 s = 480 s), against
# client TTFT p95 <= SLO_TTFT_MS and client ITL p95 <= SLO_ITL_MS.
# Every level is even: the two AIPerf clients take half the sessions each.
LEVELS="4 8 12 16 24 32 48 64"
LEVEL_SECONDS=960
STEADY_FROM=500
SLO_TTFT_MS=5000
SLO_ITL_MS=50
# Request fields added to every chat completion (AIPerf --extra-inputs, key:value pairs).
EXTRA_INPUTS="ignore_eos:true"
