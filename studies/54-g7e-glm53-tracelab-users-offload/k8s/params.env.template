# Rendered by the Akamas FileConfigurator task into params.env, then sourced by apply_config.sh,
# which turns each value into a vLLM flag appended to VLLM_ADDITIONAL_ARGS. Any value may be EMPTY
# (a parameter the step lists in doNotRenderParameters): no flag, vLLM's own default.
# KV_OFFLOADING_SIZE 0 and SPEC_TOKENS 0 also mean no flag (no offload, no MTP).
KV_OFFLOADING_SIZE=${vllm.kv_offloading_size}
# native or lmcache (study 54's LMCache 512 preset); empty = native. Used only with an offload size > 0.
KV_OFFLOADING_BACKEND=${vllm.kv_offloading_backend}
GPU_MEMORY_UTILIZATION=${vllm.gpu_memory_utilization}
MAX_NUM_SEQS=${vllm.max_num_seqs}
MAX_NUM_BATCHED_TOKENS=${vllm.max_num_batched_tokens}
SPEC_TOKENS=${vllm.spec_tokens}
MOE_BACKEND=${vllm.moe_backend}
MAX_CUDAGRAPH_CAPTURE_SIZE=${vllm.max_cudagraph_capture_size}
ASYNC_SCHEDULING=${vllm.async_scheduling}
PERFORMANCE_MODE=${vllm.performance_mode}
OPTIMIZATION_LEVEL=${vllm.optimization_level}
