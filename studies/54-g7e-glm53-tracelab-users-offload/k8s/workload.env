# Study 54 workload and rig values, sourced by apply_config.sh, run_test.sh, stop_aiperf.sh,
# aiperf_csv.sh and ../load/prepare_load.sh. Design:
# docs/superpowers/specs/2026-11-20-study-54-glm53-tracelab-users-offload-design.md. Every value the
# target changes lives here (design "Portability"); nothing changes once the study has started.

# --- Rig ---------------------------------------------------------------------------------------
NS=glm53-coding
URL=http://vllm.glm53-coding.svc:8000
MODEL=zai-org/GLM-5.3-Flash                     # served model name (AIPerf --model)
PROM_SVC=monitoring/kube-prometheus-stack-prometheus:http-web   # reached with kubectl get --raw

# --- Load: TraceLab v0.0.2 replayed by AIPerf 0.13.0 (../load/README.md) -------------------------
TRACELAB_URL=https://github.com/uw-syfi/TraceLab/releases/download/v0.0.2/syfi_coding_trace.jsonl.gz
TRACELAB_SHA256=11ce51ec0a25e3d1d95b025bca2f7d1647e47571eb7cc968acd5fc64d4b4fb65
POOL_SESSIONS=600     # sessions per client pool (two disjoint pools, one per client)
POOL_SEED=54
HORIZON_MIN=80        # a session keeps the rounds reachable within 80 min of replay
CAP_S=1200            # developer pauses capped at 20 min (also AIPerf --inter-turn-delay-cap-seconds)
SYS_TOKENS=8000       # shared system prompt (../load/sys8k.txt), subtracted from every round
# sha256 of the decompressed pools and md5 of the prompt (the calibration's, 2026-11-20)
POOL0_SHA=6220ca10dcd769b02c89c186be6230327d1145bf2ce264f0235e742c92c2b34c
POOL1_SHA=3fa450cbecfc2db94368431cdf67e27932fe267575f79e82013d884d5c1b1ea9
SYS_MD5=7342a71a76a5f5314f8e238a2767f050
LOAD_DIR=/work/study54-load   # on the toolbox: pool_0.jsonl.gz, pool_1.jsonl.gz, sys8k.txt

# --- Ramp: users per client enter linearly over RAMP_S and never leave; the replay runs RAMP_S + 300 s
# (pending the slow-slope calibration, design "Calls for the build")
USERS_PER_CLIENT=50
RAMP_S=4200

# --- SLO (the user's, study 52): client side, p95 over the trailing 150 s -------------------------
SLO_TTFT_MS=5000
SLO_ITL_MS=50
# The knee: the first of BREACH_BUCKETS consecutive 30 s buckets over either threshold, each with at
# least MIN_WINDOW_REQS requests in its 150 s window; the CSV Akamas reads ends before it.
BREACH_BUCKETS=4
MIN_WINDOW_REQS=20

# --- Watchdog (run_test.sh): ends the run with success past the knee -----------------------------
WD_TTFT_MS=10000      # server TTFT p95 over 150 s (vLLM histogram, Prometheus), 2x the SLO
WD_HOLD_S=120
WD_ARM_DELAY_S=300    # after vLLM completes the run's first request
STALL_S=900           # no request completed for this long: the trial fails
DEADLINE_EXTRA_S=900  # deadline = RAMP_S + DEADLINE_EXTRA_S (AIPerf start-up, the ramp, the hold)

# --- Toolbox paths --------------------------------------------------------------------------------
RUNS_DIR=/work/study54-runs                 # per run: c0.jsonl.gz, c1.jsonl.gz, logs; current = the run name
CSV_DIR=/work/aiperf-csv/study54            # the CSV File telemetry reads *.csv here (cut at the knee)
CSV_FULL_DIR=/work/aiperf-csv-full/study54  # the same, uncut (analysis only)
